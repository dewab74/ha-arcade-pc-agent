# Copy to .env (gitignored) and fill in. Used by scripts/install-arcade-pc-agent.sh
# and scripts/arcade-pc-remote.sh, which install the agent over SSH from
# macOS/Linux. Installing on the PC itself needs none of this: run
# scripts/install-arcade-pc-agent.ps1 there and use the tray icon's Settings.

# --- SSH login of the Windows PC (its signed-in user, an administrator) ---
ARCADE_PC_HOST=arcade-pc.example.org
ARCADE_PC_USERNAME=arcade
ARCADE_PC_PASSWORD=replace-me

# --- MQTT broker -----------------------------------------------------------
AGENT_MQTT_HOST=homeassistant.example.org
# 1883 without TLS; with TLS usually 8883.
AGENT_MQTT_PORT=1883
AGENT_MQTT_TLS=false
# With TLS: check the broker's certificate (default true). Set false only for a
# self-signed certificate you can't give as AGENT_CA_FILE.
AGENT_MQTT_VERIFY=true
# Empty for a broker without authentication.
AGENT_MQTT_USERNAME=arcade-pc-agent
# A command that prints the MQTT password, so it never sits in this file,
# e.g. `vault kv get -field=password secret/arcade-pc-agent`, `op read op://...`,
# or `security find-generic-password -s arcade-pc-agent -w`. Leave empty to keep
# the password already stored on the PC (or for a broker without one).
AGENT_MQTT_PASSWORD_COMMAND=
# Optional PEM of a private CA the broker's certificate must chain to.
AGENT_CA_FILE=

# --- Home Assistant (all optional) -------------------------------------------
AGENT_NODE_ID=
AGENT_DEVICE_NAME=
AGENT_AREA=
# Pin the mute/volume entity ids (default switch.<node>_mute / number.<node>_volume).
AGENT_MUTE_ENTITY_ID=
AGENT_VOLUME_ENTITY_ID=

# --- This PC (all optional) --------------------------------------------------
# LaunchBox folder (default C:\LaunchBox).
AGENT_LAUNCHBOX_DIR=
# Folder of an external input watcher, for PCs with phantom input (see docs).
AGENT_INPUT_WATCH_DIR=
# UNC share to report reachability for, e.g. \\nas\games
AGENT_NAS_SHARE=
